EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# RevenueCat (in-app purchases for apps you ship — not for buying ShipNative)
# Native IAP requires a development build / EAS — not Expo Go.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-api-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-api-key
# Optional — must match the entitlement identifier in the RevenueCat dashboard
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
